# Copy this file to .env and fill in your own machine's LAN IP.
# Do NOT commit .env — each teammate's LAN IP is different.
#
# How to find your LAN IP:
#   Windows:  ipconfig            -> look for "IPv4 Address"
#   Mac/Linux: ifconfig | grep inet   (or `ip addr` on Linux)
#
# The backend server (server.js) must be running and reachable from your
# phone/emulator on this same network for the mobile app to log in.

EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
